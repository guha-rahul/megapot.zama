{
  "name": "megapot-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "preflight": "node scripts/preflight.mjs",
    "abi:gen": "node scripts/gen-abi.mjs",
    "abi:check": "node scripts/gen-abi.mjs && git diff --exit-code --quiet lib/abi/generated.ts || (echo 'lib/abi/generated.ts is stale \u2014 commit the regenerated file' && exit 1)"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.0",
    "@zama-fhe/relayer-sdk": "0.4.1",
    "next": "14.2.25",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "viem": "^2.21.0",
    "wagmi": "^2.14.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.7.3"
  }
}
