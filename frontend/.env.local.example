# Addresses from deployments/<network>.json after `npx hardhat megapot:deploy`
NEXT_PUBLIC_MEGAPOT=0x
NEXT_PUBLIC_CUSDC=0x
NEXT_PUBLIC_USDC=0x

# 11155111 = Ethereum Sepolia (where the Zama Protocol testnet lives), 31337 = local hardhat node
NEXT_PUBLIC_CHAIN_ID=11155111

# Optional RPC override; defaults to the chain's public endpoint
NEXT_PUBLIC_RPC_URL=
